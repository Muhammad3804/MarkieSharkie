{
  "name": "markiesharkie-server",
  "version": "0.1.0",
  "private": true,
  "description": "MarkieSharkie REST API (Express + pg). See docs/architecture.md.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:test": "node scripts/migrate.js --test",
    "migrate:create": "node scripts/createMigration.js",
    "db:check": "node scripts/dbCheck.js",
    "create-admin": "node scripts/createAdmin.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed": "node scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "argon2": "0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "node-pg-migrate": {
      "glob": "^14.0.6"
    }
  }
}
