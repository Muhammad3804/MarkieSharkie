# server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://markie_app:markie_dev_password@localhost:5432/markiesharkie
TEST_DATABASE_URL=postgres://markie_app:markie_dev_password@localhost:5432/markiesharkie_test
# The server refuses to start with this placeholder. Use 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_INACTIVITY_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SLOT_HOLD_MINUTES=10
# Express "trust proxy": false locally; set to 1 (or true) behind one reverse proxy so rate limits see the real client IP
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# external services (leave blank to use the fake adapters)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
IMAGE_DETECTION_API_KEY=
IMAGE_GENERATION_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# client (Vite exposes only VITE_*; never put secrets here)
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
