# server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://markie_app:markie_dev_password@localhost:5432/markiesharkie
TEST_DATABASE_URL=postgres://markie_app:markie_dev_password@localhost:5432/markiesharkie_test
# The server refuses to start with this placeholder. Use 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
SESSION_INACTIVITY_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
SLOT_HOLD_MINUTES=10
# Express "trust proxy": false locally; set to 1 (or true) behind one reverse proxy so rate limits see the real client IP
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Password reset email (REQ-2). Leave SMTP_HOST blank in development: the code is then printed in the server
# console instead of emailed. Production needs real SMTP settings. Port 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MarkieSharkie <no-reply@markiesharkie.pk>
# First admin, created by `npm run seed:admin` (inside server/). Running it again changes nothing unless you add
# `-- --reset-password`. Password rules as signup: 8+ characters with letters and digits. Never commit real values.
SEED_ADMIN_NAME=Site Admin
SEED_ADMIN_EMAIL=admin@example.pk
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_ADMIN_PHONE=0300-0000000
SEED_ADMIN_CITY=Faisalabad
# `npm run seed` (inside server/): password for demo.customer@, demo.owner@ and demo.decorator@markiesharkie.pk.
# Leave empty to skip the demo accounts. 8+ characters with letters and digits; never commit a real one.
SEED_DEMO_PASSWORD=
# external services (leave blank to use the fake adapters)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI image detection (REQ-9) via Sightengine (server only, never VITE_*). Leave the user / secret empty to use the
# fake detector (every photo genuine), e.g. in development without an account.
IMAGE_DETECTION_PROVIDER=sightengine
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
IMAGE_DETECTION_TIMEOUT_MS=10000
# Score at or below GENUINE -> genuine; above it -> flagged for an admin; from FLAG up -> marked high confidence.
IMAGE_DETECTION_FLAG_THRESHOLD=0.8
IMAGE_DETECTION_GENUINE_THRESHOLD=0.3
# Uploaded files (local disk adapter; empty = server/uploads, git-ignored) and the API's public origin used in
# file URLs (empty = the address each request came in on; set it behind a proxy or CDN).
UPLOADS_DIR=
PUBLIC_API_ORIGIN=
IMAGE_GENERATION_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# client (Vite exposes only VITE_*; never put secrets here). Vite reads .env from client/, not from this root file:
# to change these, put them in client/.env. Without one the client uses http://localhost:4000/api.
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
